# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db

# Office lock/temp files
~$*

# Large ML artifacts
*.pt
*.pth
*.onnx
*.engine
runs/
datasets/
outputs/
results/

# Local caches
*.cache
*.tmp

# 앱이 만들어낸 조사표 (산출물이므로 저장소에 두지 않는다)
/report.xlsx

# 실제 비밀번호/자격증명 (example만 git 관리)
scripts/sweep/mail_config.yaml

# Cloudflare Quick Tunnel 실행 시 생기는 임시 주소/로그 (재실행마다 바뀜)
apps/AI_CCTV/public_url.txt
apps/AI_CCTV/tunnel.log


# 참고용 외부 연구자료 PDF (배포 대상 아님, 용량이 크다)
docs/*.pdf

# Claude 대화기록/기억 사본 — 다른 PC에서 이어서 하려고 드라이브에 옮겨둔 것.
# 용량이 크고 저장소에 들어갈 내용이 아니다. docs/HANDOFF.md 참고.
.handoff/

# 작업 보고서 — 외장하드에만 둔다(깃에 올리지 않음).
# 세션마다 쌓이고 내부 실측치·현장 자료가 섞여 있어 저장소에 두지 않기로 했다.
# 이미 올라가 있던 것은 `git rm --cached`로 추적만 해제했다(파일은 디스크에 남아 있다).
docs/reports/

# 제출 패키지의 app/ 은 apps/AI_CCTV 의 사본이다(압축 배포용).
# 원본이 저장소에 있으므로 사본은 추적하지 않는다.
/제출용/app/

# 제출용 압축 산출물 (패키지_만들기.ps1 -Zip 이 만든다)
/하수관로CCTV자동분석_제출.zip

# LLM 판독 예시 사진(237장, 30MB). 모델 파일과 같은 이유로 깃에 넣지 않는다.
# 원본은 <드라이브>:/CCTV/ver.2.0_학습데이터 이고, 패키지_만들기.ps1 이
# assets/llm_examples 로 복사해 배포본에 담는다.
/apps/AI_CCTV/assets/llm_examples/
